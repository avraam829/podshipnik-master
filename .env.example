# Django settings
# Change these values in your .env file on the production server
DJANGO_SECRET_KEY=your_production_secret_key
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=your_domain.com,www.your_domain.com

# Database settings (example for PostgreSQL, uncomment and configure as needed)
# DB_NAME=your_db_name
# DB_USER=your_db_user
# DB_PASSWORD=your_db_password
# DB_HOST=localhost
# DB_PORT=5432
