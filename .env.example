# Local development. Generate a secret before production; never commit .env.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
PRIMARY_DOMAIN=localhost:8000
WEB_PORT=8000
ADDITIONAL_DOMAINS=
# Caddy site labels, comma separated. Production: primary domain and every alias.
SITE_DOMAINS=localhost
TRUST_PROXY=False
# Optional, defaults to db.sqlite3 in project. Compose uses /data/db.sqlite3.
# DATABASE_PATH=
# Telegram is optional and never launched by the web container.
TG_BOT_TOKEN=
TG_ADMIN_CHAT_ID=
